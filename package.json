{
  "name": "jason-digital-human-face",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5195",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5195",
    "build:single": "node scripts/build-single.mjs",
    "avatars:compress": "node scripts/compress-avatars.mjs",
    "predeploy": "node scripts/ensure-profile.mjs",
    "deploy": "npm run build && wrangler deploy",
    "pretest": "node scripts/ensure-profile.mjs",
    "test": "node --test worker/*.test.mjs src/*.test.mjs",
    "types": "wrangler types",
    "predeploy:check": "node scripts/ensure-profile.mjs",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "pretypecheck": "node scripts/ensure-profile.mjs",
    "typecheck": "npm run types && tsc --noEmit",
    "avatars:cartoon": "node scripts/build-cartoon.mjs"
  },
  "dependencies": {
    "pinyin-pro": "3.29.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.4",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "wrangler": "4.146.0"
  }
}
