{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jason-digital-human-face",
  "account_id": "9cbf75a998ccb79bb6684b3176120523",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1004202602", "simple": { "limit": 10, "period": 60 } },
    { "name": "SPEECH_LIMIT", "namespace_id": "1004202603", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
